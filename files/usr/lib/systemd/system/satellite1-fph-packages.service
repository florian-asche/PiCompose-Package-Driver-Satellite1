[Unit]
Description=PiCompose - Install the FutureProofHomes packages for the Satellite1
After=network-online.target
Wants=network-online.target
ConditionArchitecture=arm64
ConditionPathExists=!/var/lib/picompose/satellite1-fph-packages-installed

[Service]
Type=oneshot
ExecStart=/usr/bin/satellite1-install-fph-packages
ExecStartPost=/usr/bin/mkdir -p /var/lib/picompose
ExecStartPost=/usr/bin/touch /var/lib/picompose/satellite1-fph-packages-installed
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
