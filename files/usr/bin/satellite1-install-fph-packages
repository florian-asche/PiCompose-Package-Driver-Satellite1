#!/bin/bash
# Installs the packages of FutureProofHomes for the Satellite1 the way the PiCompose image does:
# download the .deb files from the GitHub releases and install them with dpkg.
# This is a temporary solution until FutureProofHomes provides an APT repository.
# It cannot run while the package that ships it is installed, because dpkg is locked then,
# so satellite1-fph-packages.service runs it at the next boot.
set -euo pipefail

KERNEL_URL="https://github.com/FutureProofHomes/RPi-Kernel-Fusb302/releases/download/v6.18.34/linux-image-6.18.34-fusb302-rpi-v8_2_arm64.deb"
SETUP_URL="https://github.com/FutureProofHomes/Satellite1-RPi-Setup/releases/download/v1.1-1/satellite1-rpi-setup_1.0-1_arm64.deb"
SDK_URL="https://github.com/FutureProofHomes/Satellite1-RPi-SDK/releases/download/v0.1.6/satellite1-rpi-sdk_0.1.6_arm64.deb"

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT
cd "$WORK_DIR"

# 1. Install the custom kernel
echo "Download and install Custom Kernel"
wget "$KERNEL_URL"
dpkg -i linux-image-*-fusb302-rpi-v8_*_arm64.deb

# 2. Install the system configuration
echo "Download and install System configuration"
wget "$SETUP_URL"
dpkg -i satellite1-rpi-setup_*_arm64.deb

# 3. Install the Python SDK
echo "Download and install Python SDK"
wget "$SDK_URL"
dpkg -i satellite1-rpi-sdk_*_arm64.deb
